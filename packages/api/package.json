{
  "name": "abbacchio",
  "version": "0.3.0",
  "description": "Abbacchio: real-time logs, metrics and traces over HTTP/OTLP — server, dashboard, and the `abbacchio` CLI (start, sandbox, bench)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mood-agency/abbacchio.git",
    "directory": "packages/api"
  },
  "type": "module",
  "bin": {
    "abbacchio": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun scripts/build.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun scripts/build.ts"
  },
  "keywords": [
    "logs",
    "logging",
    "dashboard",
    "real-time",
    "viewer",
    "server",
    "sqlite",
    "bun",
    "opentelemetry",
    "otlp",
    "sandbox"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "nanoid": "^5.1.11",
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
