{
  "name": "@abbacchio/api",
  "version": "0.2.0",
  "description": "Abbacchio API - Real-time log viewer HTTP API with SQLite persistence",
  "type": "module",
  "main": "src/server.ts",
  "types": "src/server.ts",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "bin": {
    "abbacchio": "src/server.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "start": "bun src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "logs",
    "logging",
    "dashboard",
    "real-time",
    "viewer",
    "server",
    "sqlite",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "nanoid": "^5.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0"
  }
}
