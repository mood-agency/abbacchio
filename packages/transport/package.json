{
  "name": "@abbacchio/transport",
  "version": "0.2.0",
  "description": "OTLP-native Node.js transports for Pino, Winston, and Bunyan - send logs, metrics, and traces to Abbacchio",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pino": {
      "types": "./dist/transports/pino.d.ts",
      "require": "./pino-transport.cjs",
      "default": "./dist/transports/pino.js"
    },
    "./transports/winston": {
      "types": "./dist/transports/winston.d.ts",
      "default": "./dist/transports/winston.js"
    },
    "./transports/bunyan": {
      "types": "./dist/transports/bunyan.d.ts",
      "default": "./dist/transports/bunyan.js"
    },
    "./transports/console": {
      "types": "./dist/transports/console.d.ts",
      "default": "./dist/transports/console.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test src/tests"
  },
  "keywords": [
    "pino",
    "winston",
    "bunyan",
    "logs",
    "logging",
    "transport",
    "client"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pino-abstract-transport": "^3.0.0",
    "winston-transport": "^4.9.0"
  },
  "peerDependencies": {
    "pino": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "pino": "^9.14.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mood-agency/abbacchio"
  }
}
