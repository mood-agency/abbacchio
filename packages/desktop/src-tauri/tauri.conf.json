{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abbacchio",
  "version": "0.2.0",
  "identifier": "com.abbacchio.app",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev:dashboard",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:4001",
    "beforeBuildCommand": {
      "script": "pnpm build:dashboard",
      "cwd": "../../.."
    },
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Abbacchio",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:4000 https://localhost:4000 ipc: tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
