{
  "name": "abbacchio",
  "version": "0.2.0",
  "private": true,
  "description": "Real-time log viewer dashboard with HTTP ingestion for Pino, Winston, Bunyan, and other loggers",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,dash -c blue,green \"bun run --filter @abbacchio/api dev\" \"bun run --filter @abbacchio/dashboard dev\"",
    "dev:api": "bun run --filter @abbacchio/api dev",
    "dev:dashboard": "bun run --filter @abbacchio/dashboard dev",
    "dev:desktop": "bun run --filter @abbacchio/desktop dev",
    "dev:tui": "bun run --filter @abbacchio/tui dev",
    "build": "bun run --filter '*' build",
    "build:api": "bun run --filter @abbacchio/api build",
    "build:transport": "bun run --filter @abbacchio/transport build",
    "build:dashboard": "bun run --filter @abbacchio/dashboard build",
    "build:desktop": "bun run --filter @abbacchio/desktop build",
    "build:tui": "bun run --filter @abbacchio/tui build",
    "tui": "bun run --filter @abbacchio/tui dev --",
    "start": "bun run --filter @abbacchio/api start",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "bump": "node scripts/bump-version.js"
  },
  "keywords": [
    "pino",
    "winston",
    "bunyan",
    "logs",
    "logging",
    "dashboard",
    "real-time",
    "http-polling",
    "viewer",
    "transport"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/bunyan": "^1.8.11",
    "bunyan": "^1.8.15",
    "concurrently": "^9.2.1",
    "oxlint": "1.89.0",
    "pino": "^10.3.1",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ]
}
